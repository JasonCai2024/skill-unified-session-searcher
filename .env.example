# ==============================================================================
# skill-unified-session-searcher 环境配置模版
# 复制本文件为 .env 即可生效自定义配置。本技能默认完全使用本地标准目录，无需修改即可直接运行。
# ==============================================================================

# 可选：自定义 agent-prompt-pattern-extractor 知识库与状态机目录绝对路径
# EXTRACTOR_ROOT_PATH="E:/BaiduSyncdisk/WorkSpace/ForAgent/SKILLS-编程基础/agent-prompt-pattern-extractor"

# 可选：自定义默认检索限制数量 (默认 10)
# DEFAULT_SEARCH_LIMIT=10

# 可选：调试输出日志等级 (INFO / DEBUG / WARNING)
# LOG_LEVEL="INFO"
